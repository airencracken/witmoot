#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
case "$1" in
	configure)
		if ! getent group witmoot >/dev/null; then
			addgroup --system witmoot || exit 1
		fi
		if ! getent passwd witmoot >/dev/null; then
			adduser --system --ingroup witmoot --home /var/lib/witmoot \
				--no-create-home --shell /usr/sbin/nologin witmoot || exit 1
		fi
		if [ "$(id -u witmoot)" = 0 ] || [ "$(getent group witmoot | cut -d: -f3)" = 0 ]; then
			echo 'Refusing to run witmoot with a root service account or group.' >&2
			exit 1
		fi
		install -d -o witmoot -g witmoot -m 0700 /var/lib/witmoot || exit 1
		if [ -d /run/systemd/system ]; then
			systemctl daemon-reload || exit 1
			# Restart an already-running board on upgrade; never start or enable
			# a new installation before the operator has configured it.
			deb-systemd-invoke try-restart witmoot.service || exit 1
		fi
		;;
esac
exit 0
