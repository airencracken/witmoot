# /etc/witmoot/witmoot.env -- restart Witmoot after editing.
# systemd environment syntax: quotes are allowed, shell expansion is not.
WITMOOT_ADDR=127.0.0.1:8082
WITMOOT_DATA_DIR=/var/lib/witmoot
WITMOOT_NAME="Witmoot"

# Set these before exposing the board through an HTTPS reverse proxy.
# WITMOOT_BASE_URL=https://board.example.org
# WITMOOT_SECURE_COOKIES=true
# WITMOOT_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# WITMOOT_IMVAULT_URL=https://photos.example.org

# Trust a private CA, for example for the mail relay; also used by the sandbox.
# SSL_CERT_FILE=/etc/witmoot/ca-bundle.pem

# Optional Linux confinement; see docs/sandbox.md.
# Whole-service confinement uses an ExecStart override; see docs/sandbox.md.

# Built-in compressed backups: daily, seven copies, 10 GiB archive cap,
# 5 GiB maximum uncompressed snapshot. Set interval to 0 to disable.
# WITMOOT_BACKUP_INTERVAL="24h"
# WITMOOT_BACKUP_KEEP="7"
# WITMOOT_BACKUP_MAX_BYTES="10737418240"
# WITMOOT_BACKUP_COPY_MAX_BYTES="5368709120"
