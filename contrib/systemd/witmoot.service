[Unit]
Description=Witmoot bulletin board
Documentation=https://github.com/airencracken/witmoot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
StandardOutput=journal
StandardError=journal
SyslogIdentifier=witmoot
User=witmoot
Group=witmoot
UMask=0077
Environment=WITMOOT_DATA_DIR=/var/lib/witmoot
Environment=WITMOOT_ADDR=127.0.0.1:8082
# EnvironmentFile takes a literal path, including any spaces, without shell quotes.
EnvironmentFile=-/etc/witmoot/witmoot.env
StateDirectory=witmoot
StateDirectoryMode=0700
ExecStart="/usr/local/bin/witmoot"
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# A custom data directory also needs a ReadWritePaths= override.

[Install]
WantedBy=multi-user.target
